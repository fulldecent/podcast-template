// Documentation:
//  - https://github.com/devcontainers/images/tree/main/src/jekyll
//    Do not use that image. It pegs Ruby 3.4, and GitHub Pages runs the Ruby in .ruby-version.
//  - https://github.com/devcontainers/images/tree/main/src/ruby
//  - https://github.com/devcontainers/features/tree/main/src/node

{
  "name": "Jekyll",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.3-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    }
  },
  "forwardPorts": [4000],
  "postCreateCommand": "bundle install"
}
